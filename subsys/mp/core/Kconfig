config MP_THREADS_NUM
	int "Maximum number of threads"
	range 0 255
	default 3

config MP_THREAD_STACK_SIZE
	int "Stack size of a thread"
	default 1024

config MP_THREAD_DEFAULT_PRIORITY
	int "Priority of a thread"
	default 5

config MP_QUEUE
	bool "Queue element (pipeline-level threading)"
	help
	  Enable the queue element which decouples pipeline segments
	  into separate threads for parallel processing. The queue
	  deposits buffers into a FIFO and spawns a dedicated thread
	  to drive the downstream segment.

config MP_WORKQUEUE
	bool "Element-level work offload (P4WQ)"
	select SCHED_DEADLINE
	help
	  Enable element-level work offloading via a shared P4WQ
	  (Pooled Parallel Preemptible Priority-based Work Queue)
	  thread pool. Elements can submit finite work items (e.g.,
	  decode, inference) to be processed on pool threads with
	  configurable priority.

config MP_WORKQUEUE_THREADS_NUM
	int "Number of threads in MP workqueue pool"
	default 1
	depends on MP_WORKQUEUE
	help
	  Number of threads in the shared P4WQ pool used for
	  element-level work offload.

config MP_WORKQUEUE_STACK_SIZE
	int "Stack size for MP workqueue pool threads"
	default 4096
	depends on MP_WORKQUEUE
	help
	  Stack size in bytes for each thread in the MP workqueue pool.

config MP_CAPSFILTER
	bool "Capsfilter support"

config MP_NET_BUF_POOL_COUNT
	int "Number of buffers can be handled at the same time for the whole pipeline"
	default 1

# Caps object pools
#
# Caps, structures and values are small, short-lived objects that are created
# and destroyed frequently during caps negotiation. They are served from these
# statically sized pools rather than the system heap, providing deterministic,
# fragmentation-free, bounded allocation suitable for embedded targets. Size
# them for the worst-case set of caps that can coexist at once.

config MP_CAPS_POOL_SIZE
	int "Maximum number of caps objects"
	default 8
	help
	  Number of preallocated mp_caps blocks. Caps are reference counted and
	  several typically coexist during negotiation (element caps, query caps,
	  intersection and fixation results, ...). Allocation never touches the
	  system heap.

config MP_STRUCTURE_POOL_SIZE
	int "Maximum number of caps structure objects"
	default 8
	help
	  Number of preallocated mp_structure blocks. Each caps holds one or more
	  structures (one per supported media format), and structures also back
	  query and event metadata. Size this for the total number of structures
	  that can coexist at once.

config MP_VALUE_POOL_SIZE
	int "Maximum number of value objects"
	default 32
	help
	  Number of preallocated mp_value blocks. A value describes a single
	  field (a format, a dimension, a range, a list element, ...) and is
	  shared by all caps, structures, queries and events. Size this for the
	  most complex set of caps that can coexist during negotiation.

config MP_MESSAGE_POOL_SIZE
	int "Maximum number of in-flight bus messages"
	default 8
	help
	  Number of preallocated mp_message blocks. A message stays allocated
	  from its creation until it is consumed: popped from the bus and
	  destroyed by the application, dropped by a sync listener, or
	  discarded by a flush. Size this for the maximum number of messages
	  that can be pending on all buses at once; when the pool is
	  exhausted, mp_message_new() returns NULL and the notification is
	  dropped.

	  This also sizes the message queue ring embedded in each bus (one
	  pointer per message), so a bus queue can never overflow.
