config MP_THREADS_NUM
	int "Maximum number of threads"
	range 0 255
	default 3

config MP_THREAD_STACK_SIZE
	int "Stack size of a thread"
	default 1024

config MP_THREAD_DEFAULT_PRIORITY
	int "Priority of a thread"
	default 5

config MP_QUEUE
	bool "Queue element (pipeline-level threading)"
	help
	  Enable the queue element which decouples pipeline segments
	  into separate threads for parallel processing. The queue
	  deposits buffers into a FIFO and spawns a dedicated thread
	  to drive the downstream segment.

config MP_WORKQUEUE
	bool "Element-level work offload (P4WQ)"
	select SCHED_DEADLINE
	help
	  Enable element-level work offloading via a shared P4WQ
	  (Pooled Parallel Preemptible Priority-based Work Queue)
	  thread pool. Elements can submit finite work items (e.g.,
	  decode, inference) to be processed on pool threads with
	  configurable priority.

config MP_WORKQUEUE_THREADS_NUM
	int "Number of threads in MP workqueue pool"
	default 1
	depends on MP_WORKQUEUE
	help
	  Number of threads in the shared P4WQ pool used for
	  element-level work offload.

config MP_WORKQUEUE_STACK_SIZE
	int "Stack size for MP workqueue pool threads"
	default 4096
	depends on MP_WORKQUEUE
	help
	  Stack size in bytes for each thread in the MP workqueue pool.

config MP_CAPSFILTER
	bool "Capsfilter support"

config MP_NET_BUF_POOL_COUNT
	int "Number of buffers can be handled at the same time for the whole pipeline"
	default 1

config MP_VALUE_POOL_SIZE
	int "Maximum number of mp_value objects"
	default 128
	help
	  Capacity of the static pool used to allocate mp_value instances.
	  mp_value is a fixed-size tagged union; this option bounds the
	  total number of values (including list items and structure fields)
	  that can be live at the same time across the whole pipeline.

config MP_STRUCTURE_POOL_SIZE
	int "Maximum number of mp_structure objects"
	default 16
	help
	  Capacity of the static pool used to allocate mp_structure
	  instances. Each set of capability fields (e.g. one media format
	  inside a caps) consumes one slot.

config MP_CAPS_POOL_SIZE
	int "Maximum number of mp_caps objects"
	default 16
	help
	  Capacity of the static pool used to allocate mp_caps instances.
	  Each pad's caps reference, query, and intermediate intersect
	  result consumes one slot.
